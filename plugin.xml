<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-m-document-scanner"
        version="1.1.1">
  <name>MDocumentScanner</name>
  <description>Production document scanning for OutSystems 11 on iOS and Android.</description>
  <license>MIT</license>
  <keywords>cordova,outsystems,document,scanner,visionkit,vision,mlkit</keywords>

  <engines>
    <engine name="cordova-android" version=">=12.0.0" />
    <engine name="cordova-ios" version=">=7.0.0" />
  </engines>

  <js-module src="www/MDocumentScanner.js" name="MDocumentScanner">
    <clobbers target="cordova.plugins.mDocumentScanner" />
  </js-module>
  <js-module src="www/options.js" name="MDocumentScannerOptions">
  </js-module>

  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="MDocumentScanner">
        <param name="android-package" value="com.mubadala.documentscanner.MDocumentScanner" />
      </feature>
    </config-file>
    <source-file src="src/android/MDocumentScanner.java" target-dir="src/com/mubadala/documentscanner" />
    <preference name="MLKIT_DOCUMENT_SCANNER_VERSION" default="16.0.0" />
    <framework src="com.google.android.gms:play-services-mlkit-document-scanner:$MLKIT_DOCUMENT_SCANNER_VERSION" />
  </platform>

  <platform name="ios">
    <preference name="CAMERA_USAGE_DESCRIPTION" default="Scan documents using the camera." />
    <preference name="PHOTOLIBRARY_USAGE_DESCRIPTION" default="Select a document image from the photo library." />
    <config-file target="config.xml" parent="/*">
      <preference name="SwiftVersion" value="5" />
      <feature name="MDocumentScanner">
        <param name="ios-package" value="MDocumentScanner" />
      </feature>
    </config-file>
    <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
      <string>$CAMERA_USAGE_DESCRIPTION</string>
    </config-file>
    <config-file target="*-Info.plist" parent="NSPhotoLibraryUsageDescription">
      <string>$PHOTOLIBRARY_USAGE_DESCRIPTION</string>
    </config-file>
    <source-file src="src/ios/MDocumentScanner.swift" />
    <source-file src="src/ios/MDWeScan/Common/CIRectangleDetector.swift" />
    <source-file src="src/ios/MDWeScan/Common/EditScanCornerView.swift" />
    <source-file src="src/ios/MDWeScan/Common/Error.swift" />
    <source-file src="src/ios/MDWeScan/Common/Quadrilateral.swift" />
    <source-file src="src/ios/MDWeScan/Common/QuadrilateralView.swift" />
    <source-file src="src/ios/MDWeScan/Common/VisionRectangleDetector.swift" />
    <source-file src="src/ios/MDWeScan/Edit/EditImageViewController.swift" />
    <source-file src="src/ios/MDWeScan/Edit/EditScanViewController.swift" />
    <source-file src="src/ios/MDWeScan/Edit/ZoomGestureController.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/AVCaptureVideoOrientation+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/Array+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CGAffineTransform+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CGImagePropertyOrientation.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CGPoint+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CGRect+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CGSize+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/CIImage+Utils.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/UIImage+Orientation.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/UIImage+SFSymbol.swift" />
    <source-file src="src/ios/MDWeScan/Extensions/UIImage+Utils.swift" />
    <source-file src="src/ios/MDWeScan/ImageScannerController.swift" />
    <source-file src="src/ios/MDWeScan/Protocols/CaptureDevice.swift" />
    <source-file src="src/ios/MDWeScan/Protocols/Transformable.swift" />
    <source-file src="src/ios/MDWeScan/Review/ReviewViewController.swift" />
    <source-file src="src/ios/MDWeScan/Scan/CameraScannerViewController.swift" />
    <source-file src="src/ios/MDWeScan/Scan/CaptureSessionManager.swift" />
    <source-file src="src/ios/MDWeScan/Scan/FocusRectangleView.swift" />
    <source-file src="src/ios/MDWeScan/Scan/RectangleFeaturesFunnel.swift" />
    <source-file src="src/ios/MDWeScan/Scan/ScannerViewController.swift" />
    <source-file src="src/ios/MDWeScan/Scan/ShutterButton.swift" />
    <source-file src="src/ios/MDWeScan/Session/CaptureSession+Flash.swift" />
    <source-file src="src/ios/MDWeScan/Session/CaptureSession+Focus.swift" />
    <source-file src="src/ios/MDWeScan/Session/CaptureSession+Orientation.swift" />
    <source-file src="src/ios/MDWeScan/Session/CaptureSession.swift" />
    <source-file src="src/ios/MDScannerFileStore.swift" />
    <framework src="AVFoundation.framework" />
    <framework src="CoreImage.framework" />
    <framework src="CoreMotion.framework" />
    <framework src="Vision.framework" />
    <framework src="VisionKit.framework" weak="true" />
  </platform>
</plugin>
